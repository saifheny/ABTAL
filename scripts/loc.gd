static func _ensure_translations() -> void:
	if _translations_ready:
		return
	_translations_ready = true
	for lc in SUPPORTED:
		var tr_obj := Translation.new()
		tr_obj.locale = lc
		var dict: Dictionary = STRINGS.get(lc, {})
		for k in dict.keys():
			tr_obj.add_message(str(k), str(dict[k]))
		TranslationServer.add_translation(tr_obj)


static func get_os_lang_tag(locale_override: String = "") -> String:
	var raw := (locale_override if locale_override != "" else OS.get_locale_language()).strip_edges().to_lower()
	if raw == "" and locale_override == "":
		raw = OS.get_locale().strip_edges().to_lower()
	var u := raw.find("_")
	if u > 0:
		raw = raw.left(u)
	var d := raw.find("-")
	if d > 0:
		raw = raw.left(d)
	return raw


static func resolve_os_lang(locale_override: String = "") -> String:
	var tag := get_os_lang_tag(locale_override)
	if tag in SUPPORTED:
		return tag
	return "ar"


static func sync_to_os_locale(locale_override: String = "") -> bool:
	var resolved := resolve_os_lang(locale_override)
	if resolved != _lang:
		set_lang(resolved)
		return true
	return false


static func get_lang() -> String:
	_ensure_translations()
	if _lang != "":
		return _lang
	for arg_group in [OS.get_cmdline_user_args(), OS.get_cmdline_args()]:
		for a in arg_group:
			var s := str(a)
			if s.begins_with("--lang="):
				var code := s.substr(7).strip_edges().to_lower()
				if code in SUPPORTED:
					_lang = code
					TranslationServer.set_locale(_lang)
					return _lang
	_lang = resolve_os_lang()
	TranslationServer.set_locale(_lang)
	return _lang


static func set_lang(code: String) -> void:
	_ensure_translations()
	var c := code.to_lower()
	_lang = c if (c in SUPPORTED) else "ar"
	TranslationServer.set_locale(_lang)


static func is_rtl() -> bool:
	return get_lang() == "ar"


static func dir_layout() -> int:
	return Control.LAYOUT_DIRECTION_RTL if is_rtl() else Control.LAYOUT_DIRECTION_LTR


static func t(key: String) -> String:
	var lang := get_lang()
	var res := TranslationServer.translate(key)
	if res != key:
		return res
	var dict: Dictionary = STRINGS.get(lang, STRINGS["ar"])
	if dict.has(key):
		return str(dict[key])
	return str(STRINGS["ar"].get(key, key))


static func hero_name(char_id: String) -> String:
	match char_id:
		"seif":
			return t("hero_seif")
		"youssef":
			return t("hero_youssef")
		_:
			return t("hero_haneen")


const AR_ORDINALS := [
	"الأولى", "الثانية", "الثالثة", "الرابعة", "الخامسة",
	"السادسة", "السابعة", "الثامنة", "التاسعة", "العاشرة",
	"الحادية عشرة", "الثانية عشرة", "الثالثة عشرة", "الرابعة عشرة", "الخامسة عشرة",
	"السادسة عشرة", "السابعة عشرة", "الثامنة عشرة", "التاسعة عشرة", "العشرون",
	"الحادية والعشرون", "الثانية والعشرون", "الثالثة والعشرون", "الرابعة والعشرون", "الخامسة والعشرون",
	"السادسة والعشرون", "السابعة والعشرون", "الثامنة والعشرون", "التاسعة والعشرون", "الثلاثون"
]


static func kingdom_ord(k: int) -> String:
	var idx := clampi(k - 1, 0, AR_ORDINALS.size() - 1)
	if get_lang() == "ar":
		return AR_ORDINALS[idx]
	return str(k)


static func start_journey_text(target_lvl: int) -> String:
	return t("journey_btn_fmt") % kingdom_ord(target_lvl)


static func journey_banner_text(target_lvl: int) -> String:
	return t("journey_banner_fmt") % kingdom_ord(target_lvl)


static func kingdom_label(k: int) -> String:
	return t("kingdom_fmt") % kingdom_ord(k)
